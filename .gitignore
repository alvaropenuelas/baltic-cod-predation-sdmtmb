# R standard
.Rhistory
.RData
.Ruserdata
.Rproj.user/
*-Ex.R
/*.tar.gz
/*.Rcheck/
.httr-oauth
*_cache/
*.utf8.md
*.knit.md
.Renviron
Rplots.pdf

# renv — commit lockfile, ignore installed library
renv/library/
renv/python/
renv/staging/
renv/local/
renv/cellar/

# Raw data — fetch from data-raw/01_download script
data/raw/
data-raw/*.zip
data-raw/*.nc

# Intermediate processed data — regenerated by analysis scripts
data/processed/
data/*.rds
data/*.qs
data/*.parquet
!data/.gitkeep

# sdmTMB fitted model objects (large — distributed via GitHub Releases/piggyback)
outputs/models/
!outputs/models/.gitkeep

# Predictions and large spatial files
outputs/predictions/
outputs/*.tif
outputs/*.gpkg

# KEEP final figures and tables (small PNGs — committed)
!outputs/figures/
!outputs/figures/*.png
!outputs/figures/*.pdf

# Quarto build outputs (not source)
/_site/
/_freeze/
/_book/
docs/_site/

# Dashboard — Node deps and build output (committed: src/, public/, config files)
dashboard/node_modules/
dashboard/dist/
dashboard/.env*.local

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
